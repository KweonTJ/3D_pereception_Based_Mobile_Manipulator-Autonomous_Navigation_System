<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="grasp_support_table">
      <static>1</static>
      <pose>-1.60 -0.50 0 0 0 0</pose>
      <link name="top">
        <pose>0 0 0.157 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.30 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.30 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.42 0.48 0.52 1</ambient>
            <diffuse>0.42 0.48 0.52 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg_front_left">
        <pose>0.115 0.115 0.0735 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.025 0.025 0.147</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.025 0.025 0.147</size>
            </box>
          </geometry>
          <material>
            <ambient>0.30 0.34 0.36 1</ambient>
            <diffuse>0.30 0.34 0.36 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg_front_right">
        <pose>0.115 -0.115 0.0735 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.025 0.025 0.147</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.025 0.025 0.147</size>
            </box>
          </geometry>
          <material>
            <ambient>0.30 0.34 0.36 1</ambient>
            <diffuse>0.30 0.34 0.36 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg_back_left">
        <pose>-0.115 0.115 0.0735 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.025 0.025 0.147</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.025 0.025 0.147</size>
