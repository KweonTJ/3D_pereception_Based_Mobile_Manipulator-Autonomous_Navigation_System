        </visual>
      </link>
      <link name="leg_back_right">
        <pose>-0.115 -0.115 0.0735 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.025 0.025 0.147</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
