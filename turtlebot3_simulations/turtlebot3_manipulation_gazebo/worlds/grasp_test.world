            <diffuse>0.30 0.34 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="grasp_test_cube">
      <static>0</static>
      <pose>-1.60 -0.50 0.217 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000054</ixx>
            <iyy>0.000054</iyy>
            <izz>0.000030</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
